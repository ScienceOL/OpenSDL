            token outputs:surface.connect = </root/_materials/Elastomer/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Elastomer"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.018, 0.023, 0.025)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.8
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "Ceramic_and_PTFE"
        {
            token outputs:surface.connect = </root/_materials/Ceramic_and_PTFE/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Ceramic and PTFE"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.91, 0.91, 0.87)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }

    def DomeLight "env_light"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @./textures/color_121212.hdr@
        float3 xformOp:rotateXYZ = (90, -0, 90)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
