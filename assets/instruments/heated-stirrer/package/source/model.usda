            token outputs:surface.connect = </root/_materials/Brushed_steel/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Brushed steel"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.6, 0.66, 0.69)
                float inputs:ior = 1.46
                float inputs:metallic = 0.85
                float inputs:opacity = 1
                float inputs:roughness = 0.25
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

