            token outputs:surface.connect = </root/_materials/Graphite_polymer/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Graphite polymer"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.025, 0.038, 0.042)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.42
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

